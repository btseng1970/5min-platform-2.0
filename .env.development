# Local development defaults only — matches docker-compose.yml's own
# hardcoded dev defaults (fivemin/fivemin/fivemin_dev). Never used in any
# shared, staging, or production environment; those set DATABASE_URL via
# real deployment configuration instead.
DATABASE_URL=postgres://fivemin:fivemin@127.0.0.1:55432/fivemin_dev

# Prototype feature flags — production default is always off (EnvFlagProvider
# only enables a flag when its var is literally "true"). Local/demo opts in
# explicitly here; a real production environment never loads this file.
PROTO_CAMPAIGN_SHELL_ENABLED=true
PROTO_DEMO_MEMBER_ENABLED=true
PROTO_QR_SCAN_ENABLED=true
PROTO_DRAW_ENABLED=true
PROTO_WALLET_GRANT_ENABLED=true
PROTO_MEMBER_CENTER_ENABLED=true
PROTO_ADMIN_TRACE_ENABLED=true

# Second, independent gate required (in addition to PROTO_ADMIN_TRACE_ENABLED)
# before the internal admin correlation trace route becomes servable — a
# production runtime can never expose it merely by someone flipping
# PROTO_ADMIN_TRACE_ENABLED on, since this var is never set outside local/demo.
PROTO_INTERNAL_DEMO_RUNTIME_ENABLED=true

# Prototype-only HMAC secret used to hash demo QR codes before storage. Not a
# production secret — QrService never persists the raw scanned value.
QR_SIGNING_SECRET=prototype-demo-qr-signing-secret-not-for-production

# Explicit CORS allowlist for the local browser demo journey (apps/web's dev
# server calling apps/api from a different port). Unset (the production/
# zero-config default) means no origin is allowed — never a wildcard.
PROTOTYPE_DEMO_ALLOWED_ORIGINS=http://localhost:3001
